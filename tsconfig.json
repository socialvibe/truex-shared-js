{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "maxNodeModuleJsDepth": 0
    },
    "include": [
        "./src/**/*.js",
        "./src/**/*.d.ts"
    ],
    "exclude": [
        "./src/**/__tests__/*"
    ]
}
