{
  "name": "truex-shared",
  "version": "1.11.7",
  "description": "Common JS code shared across true[X] repos",
  "private": true,
  "type": "module",
  "files": [
    "src"
  ],
  "main": "./src/",
  "scripts": {
    "test": "node --import ./src/__tests__/setup.mjs --test 'src/**/__tests__/*-test*.js'",
    "test:ci": "node --import ./src/__tests__/setup.mjs --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml 'src/**/__tests__/*-test*.js'",
    "watch": "node --import ./src/__tests__/setup.mjs --test --watch 'src/**/__tests__/*-test*.js'",
    "coverage": "node --import ./src/__tests__/setup.mjs --test --experimental-test-coverage 'src/**/__tests__/*-test*.js'"
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  },
  "dependencies": {
    "uuid": "^11.0.0"
  }
}
